# Generated by Cargo
# will have compiled files and executables
/target/
#/.idea/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here http://doc.crates.io/guide.html#cargotoml-vs-cargolock
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# --- RustRover / JetBrains Specific ---
# Ignore all of .idea folder by default
.idea/*

# Allow sharing of specific configurations
!.idea/runConfigurations/
!.idea/codeStyles/
!.idea/scopes/
!.idea/vcs.xml
!.idea/copyright/

# Explicitly ignore user-specific or sensitive settings
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries
.idea/shelf/
.idea/dataSources/ls
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/jsLibraryMappings.xml
.idea/httpRequests/
